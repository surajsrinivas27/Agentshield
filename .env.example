# Application Environment
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Shared Database Configuration (Person 1-4)
# Stable SQLite database location resolved relative to project root (data/agentshield.db)
DATABASE_URL=sqlite:///data/agentshield.db

# Authentication & JWT Configuration (Person 4)
# Generate a cryptographically secure random secret (minimum 32 bytes) in your .env:
# python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Must be distinct from MANIFEST_SIGNING_SECRET. Approved algorithm is strictly HS256.
JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_minimum_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Task Capability Manifest HMAC-SHA256 Secret (Person 4)
# Generate a separate random secret (minimum 32 bytes) in your .env:
# python -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Must be distinct from JWT_SECRET_KEY. Do not commit real keys.
MANIFEST_SIGNING_SECRET=change_this_to_a_secure_random_manifest_secret_minimum_32_bytes_long

# AI Integration (Person 2)
SARVAM_API_KEY=replace_with_your_own_key
